<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
        <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="HardRemote.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <userSettings>
        <HardRemote.Properties.Settings>
            <setting name="EnableAutomaticLight" serializeAs="String">
                <value>True</value>
            </setting>
            <setting name="COMPortNumber" serializeAs="String">
                <value>1</value>
            </setting>
            <setting name="COMBaudRate" serializeAs="String">
                <value>9600</value>
            </setting>
            <setting name="CurrentStyle" serializeAs="String">
                <value>1822-new</value>
            </setting>
            <setting name="PlayBeepsDuringAlert" serializeAs="String">
                <value>False</value>
            </setting>
            <setting name="TitleIsLineOne" serializeAs="String">
                <value>False</value>
            </setting>
        </HardRemote.Properties.Settings>
    </userSettings>
	<runtime>
		<mdaConfig>
			<assistants>
				<NonComVisibleBaseClass enabled="false"/>
			</assistants>
		</mdaConfig>
	</runtime>
</configuration>